# DocumentOps Review Gateway — 환경 변수 예시
# 실제 비밀키, 외부 LLM API 키, 실제 고객 문서는 사용하지 않습니다.

# SQLite 파일 위치 (기본: data/documentops.db)
DOCUMENTS_DB_PATH=data/documentops.db

# 허용 거래처 목록
VENDOR_REGISTRY_PATH=fixtures/vendors.json

# 평가/데모 데이터 위치
EVALUATION_DIR=fixtures/evaluation
DEMO_DIR=fixtures/demo

# 평가 리포트 출력 위치
ARTIFACTS_DIR=artifacts

# 업로드 본문 최대 크기(바이트)
MAX_UPLOAD_BYTES=524288

# API 분당 요청 제한 (0 = 비활성)
RATE_LIMIT_PER_MINUTE=120

# 리버스 프록시 뒤에서 X-Forwarded-For 신뢰 (로컬 데모 기본 false)
TRUST_PROXY_HEADERS=false

# 공개 호스팅에서는 true: 업로드·수정·판정 등 상태 변경을 모두 403으로 차단
PUBLIC_DEMO_READ_ONLY=false
